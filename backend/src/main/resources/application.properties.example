spring.application.name=TaskMaster

# Database Configuration
# Copy this file to application-dev.properties and fill in your values
spring.datasource.url=jdbc:postgresql://localhost:5432/taskmaster
spring.datasource.username=taskmaster
spring.datasource.password=your_database_password_here

# JWT Configuration
# Generate a secure 256-bit key with: openssl rand -base64 32
jwt.secret=your-256-bit-secret-key-base64-encoded-here
jwt.expiration=86400000
